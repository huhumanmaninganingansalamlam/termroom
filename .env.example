# Native install: put TERMROOM_PASSWORD in ~/.config/termroom/.env and chmod 600 it.
# Docker Compose: copy this file to .env next to compose.yaml.
TERMROOM_MODE=core
# Docker Compose activates the service matching TERMROOM_MODE. Change only TERMROOM_MODE.
COMPOSE_PROFILES=${TERMROOM_MODE}
TERMROOM_PASSWORD=change-this-password
# Default UI language for browsers that have not chosen one yet: en or ko.
TERMROOM_LOCALE=en
# Core only: keep loopback, or set the host's specific Tailscale/private IP.
TERMROOM_BIND_HOST=127.0.0.1
# Core only: enable when an HTTPS reverse proxy is the browser-facing endpoint.
TERMROOM_SECURE_COOKIE=false
# SSH/Node-only deployments can disable every local Workspace UI and route.
# TERMROOM_ALLOW_LOCAL_WORKSPACES=false
# Optional operator policy. Leave unset to accept any non-empty password.
# TERMROOM_MIN_PASSWORD_LENGTH=12
PUID=1000
PGID=1000
# Core: folders visible locally. Node: the remote host projects exposed to the Core.
TERMROOM_WORKSPACES_HOST_PATH=./workspaces
